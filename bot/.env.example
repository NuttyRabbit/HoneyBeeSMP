# The Discord bot's settings.
#
# Copy to .env and fill in. The real .env is never in git.
#
# DISCORD_TOKEN            the bot token from the Discord developer portal
# DISCORD_GUILD_ID         the server the bot is for
# DISCORD_STATUS_CHANNEL  channel to keep the player list up to date in
#                          (optional - the bot still answers /status)
# SERVER_ADDRESS           the Minecraft server's address
# SERVER_PORT              the Minecraft server's port
# POLL_SECONDS             how often to check the player list
# DISCORD_COMMAND_SCOPE    "guild" for this server only, "global" for all

DISCORD_TOKEN=your-bot-token-here
DISCORD_GUILD_ID=
DISCORD_STATUS_CHANNEL_ID=
SERVER_ADDRESS=play.honeybeesmp.co.uk
SERVER_PORT=25566
POLL_SECONDS=30
DISCORD_COMMAND_SCOPE=global
CRAFTY_URL=https://panel.honeybeesmp.co.uk
CRAFTY_API_TOKEN=
